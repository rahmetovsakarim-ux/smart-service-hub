# Copy to ".env" and fill in. ".env" is git-ignored: never commit real values.
# Spring Boot reads these as environment variables (export them, or use docker compose --env-file .env).

# ---- Database (MySQL) ----
# Either a full JDBC URL ...
DB_URL=
# ... or the parts (used when DB_URL is empty)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_service_hub
DB_USERNAME=
DB_PASSWORD=

# update = create/extend tables automatically (development); validate = only check them (production,
# create the schema from database/schema.sql first)
DDL_AUTO=update

# ---- Demo data ----
# true loads demo accounts with publicly known passwords into an EMPTY database. Never enable in production.
APP_SEED_ENABLED=false

# ---- First administrator for a fresh production database (optional) ----
# Created once, only if no administrator exists. Remove these after the first start.
APP_ADMIN_PHONE=
APP_ADMIN_EMAIL=
APP_ADMIN_NAME=Administrator
APP_ADMIN_PASSWORD=

# ---- Server ----
PORT=8080
# true when served over HTTPS (the "prod" profile turns it on as well)
SESSION_COOKIE_SECURE=false
